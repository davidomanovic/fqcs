+def _normalized(values: np.ndarray) -> np.ndarray | None:
+    out = np.asarray(values, dtype=np.float64)
+    norm = float(np.linalg.norm(out))
+    if norm == 0.0 or not np.isfinite(norm):
+        return None
+    return out / norm
